# Public Firebase web configuration (not Firebase Admin credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public Cloudinary delivery/upload configuration only; never add an API secret here.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_BASE_FOLDER=freelance-management

VITE_APP_NAME=Freelance Business Manager

# Single-admin access. These are public Vite variables; never put passwords or Admin SDK secrets here.
VITE_ADMIN_UID=
VITE_ADMIN_EMAIL=
VITE_ADMIN_LOGIN_ID=
VITE_ENABLE_DEV_PREVIEW=false
