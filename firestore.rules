rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace before manual deployment. This literal intentionally fails closed.
    function isAdmin() { return request.auth != null && request.auth.uid == 'REPLACE_WITH_FIREBASE_ADMIN_UID'; }
    function auditCreate() { return request.resource.data.ownerId == request.auth.uid && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid; }
    function auditUpdate() { return request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedBy == request.auth.uid; }
    function integerAmount(value) { return value is int && value >= 0; }

    match /appSettings/global { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate(); allow update: if isAdmin() && auditUpdate(); allow delete: if false; }
    match /users/{uid} { allow read, create: if isAdmin() && uid == request.auth.uid && auditCreate(); allow update: if isAdmin() && uid == request.auth.uid && auditUpdate(); allow delete: if false; }
    match /masterOptions/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && request.resource.data.group is string && request.resource.data.label is string && request.resource.data.normalizedLabel is string && request.resource.data.isActive is bool && request.resource.data.sortOrder is int; allow update: if isAdmin() && auditUpdate() && request.resource.data.group is string && request.resource.data.label is string && request.resource.data.normalizedLabel is string && request.resource.data.isActive is bool && request.resource.data.sortOrder is int; allow delete: if false; }

    function clientValid(data) { return data.name is string && data.normalizedName is string && data.clientTypeId is string && data.status in ['Active', 'Inactive', 'Archived'] && data.isDeleted is bool; }
    match /clients/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && clientValid(request.resource.data); allow update: if isAdmin() && auditUpdate() && clientValid(request.resource.data); allow delete: if false; }

    function projectValid(data) { return data.name is string && data.normalizedName is string && data.clientId is string && data.projectTypeId is string && data.status in ['Planning', 'Confirmed', 'In Progress', 'On Hold', 'Completed', 'Cancelled', 'Archived'] && data.priority in ['High', 'Medium', 'Low', 'Not Applicable'] && data.startDate is timestamp && data.isDeleted is bool && (data.totalAmountMinor == null || integerAmount(data.totalAmountMinor)) && integerAmount(data.receivedAmountMinor) && (data.remainingAmountMinor == null || integerAmount(data.remainingAmountMinor)); }
    match /projects/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && projectValid(request.resource.data) && request.resource.data.receivedAmountMinor == 0; allow update: if isAdmin() && auditUpdate() && projectValid(request.resource.data); allow delete: if false; }

    function accountValid(data) { return data.name is string && data.normalizedName is string && data.accountTypeId is string && data.currency is string && data.openingBalanceMinor is int && data.currentBalanceMinor is int && data.status in ['Active', 'Inactive', 'Archived'] && data.isDeleted is bool; }
    match /accounts/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && accountValid(request.resource.data); allow update: if isAdmin() && auditUpdate() && accountValid(request.resource.data); allow delete: if false; }

    function transferValid(data) { return data.fromAccountId is string && data.toAccountId is string && data.fromAccountId != data.toAccountId && data.amountMinor is int && data.amountMinor > 0 && data.currency is string && data.transferDate is timestamp && data.status in ['Active', 'Voided'] && data.isDeleted is bool; }
    match /accountTransfers/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && transferValid(request.resource.data); allow update: if isAdmin() && auditUpdate() && transferValid(request.resource.data); allow delete: if false; }

    function incomeValid(data) { return data.title is string && data.amountMinor is int && data.amountMinor > 0 && data.receivedDate is timestamp && data.incomeCategoryId is string && data.paymentModeId is string && data.accountId is string && data.currency is string && data.sourceType in ['Project Payment', 'Independent Income'] && data.status in ['Active', 'Voided'] && data.isDeleted is bool && (data.sourceType == 'Independent Income' || (data.projectId is string && data.clientId is string && data.paymentTypeId is string)); }
    match /income/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && incomeValid(request.resource.data); allow update: if isAdmin() && auditUpdate() && incomeValid(request.resource.data); allow delete: if false; }

    function expenseValid(data) { return data.title is string && data.amountMinor is int && data.amountMinor > 0 && data.currency is string && data.expenseType in ['Business', 'Project-related', 'Personal', 'Household'] && data.categoryId is string && data.expenseDate is timestamp && data.paymentStatus in ['Pending', 'Paid', 'Cancelled'] && data.isArchived is bool && (data.paymentStatus != 'Paid' || (data.paidDate is timestamp && data.accountId is string && data.paymentModeId is string)); }
    match /expenses/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && expenseValid(request.resource.data); allow update: if isAdmin() && auditUpdate() && expenseValid(request.resource.data); allow delete: if false; }

    function recurringTemplateValid(data) { return data.title is string && data.amountMinor is int && data.amountMinor > 0 && data.currency is string && data.expenseType in ['Business', 'Project-related', 'Personal', 'Household'] && data.categoryId is string && data.frequency in ['Monthly', 'Quarterly', 'Half-yearly', 'Yearly', 'Custom interval'] && data.startDate is timestamp && data.nextOccurrenceDate is timestamp && data.isActive is bool && data.isDeleted is bool; }
    match /recurringExpenseTemplates/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && recurringTemplateValid(request.resource.data); allow update: if isAdmin() && auditUpdate() && recurringTemplateValid(request.resource.data); allow delete: if false; }

    function documentValid(data) { return data.ownerUid == request.auth.uid && data.projectId is string && data.clientId is string && data.title is string && data.documentTypeId is string && data.sourceType in ['CloudinaryUpload', 'ExternalLink'] && data.status in ['Active', 'Archived'] && data.isArchived is bool && (data.sourceType == 'ExternalLink' || data.cloudinaryAssets is list); }
    match /projectDocuments/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && documentValid(request.resource.data); allow update: if isAdmin() && auditUpdate() && documentValid(request.resource.data); allow delete: if false; }
    function credentialValid(data) { return data.ownerUid == request.auth.uid && data.projectId is string && data.clientId is string && data.serviceName is string && data.serviceTypeId is string && data.accountOwnerType in ['My Account', 'Client Account', 'Shared Account'] && data.status in ['Active', 'Archived'] && data.isArchived is bool && data.ciphertext is string && data.iv is string && data.algorithm == 'AES-GCM' && data.encryptionVersion is int && !('password' in data) && !('username' in data) && !('email' in data) && !('apiKey' in data) && !('apiSecret' in data) && !('token' in data) && !('pin' in data) && !('recoveryCode' in data) && !('loginUrl' in data) && !('notes' in data) && !('credentialFields' in data) && !('plainText' in data) && !('decryptedPayload' in data); }
    match /credentials/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && credentialValid(request.resource.data); allow update: if isAdmin() && auditUpdate() && credentialValid(request.resource.data); allow delete: if false; }
    function vaultValid(data) { return data.ownerUid == request.auth.uid && data.salt is string && data.wrappingIv is string && data.wrappedVaultKey is string && data.kdf == 'PBKDF2-SHA-256' && data.iterations is int && data.iterations >= 200000; }
    match /credentialVaultConfigs/{uid} { allow read: if isAdmin() && uid == request.auth.uid; allow create: if isAdmin() && uid == request.auth.uid && auditCreate() && vaultValid(request.resource.data); allow update: if isAdmin() && uid == request.auth.uid && auditUpdate() && vaultValid(request.resource.data); allow delete: if false; }
    match /recordVersions/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate() && request.resource.data.actorUid == request.auth.uid && request.resource.data.entityType is string && request.resource.data.entityId is string && request.resource.data.action is string; allow update, delete: if false; }
    match /notificationPreferences/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate(); allow update: if isAdmin() && auditUpdate(); allow delete: if false; }
    match /notificationStates/{id} { allow read: if isAdmin(); allow create: if isAdmin() && auditCreate(); allow update: if isAdmin() && auditUpdate(); allow delete: if false; }
        match /{document=**} { allow read, write: if false; }
  }
}
